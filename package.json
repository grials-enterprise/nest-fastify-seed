{
  "name": "nestjs-seed-mongoose",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:containers": "ts-node ./tests/containers/startContainers.ts",
    "stop:containers": "ts-node ./tests/containers/stopContainers.ts",
    "lint": "oxlint src/ tests/",
    "test": "c8 --check-coverage --lines 90 --statements 90 --functions 90 --branches 85 mocha --config .mocharc.json 'tests/**/*.spec.ts'",
    "test:unit": "c8 --check-coverage --lines 90 --statements 90 --functions 90 --branches 90 mocha --config .mocharc.json 'tests/unit-tests/**/*.spec.ts'",
    "test:e2e": "c8 --check-coverage --lines 80 --statements 80 --functions 80 --branches 70 mocha --config .mocharc.json 'tests/e2e/**/*.spec.ts'",
    "test:p2p": "c8 --check-coverage --lines 90 --statements 90 --functions 85 --branches 80 mocha --config .mocharc.json 'tests/p2p/**/*.spec.ts'",
    "husky-prepare": "husky install",
    "prepare": "npm run husky-prepare",
    "precommit": "lint-staged",
    "commit": "git-cz"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@grials/shared-tools": "^1.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "fastify": "5.12.4",
    "jwt-decode": "^4.0.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@grials/testing-tools": "^1.0.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc-node/register": "^1.12.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "c8": "12.0.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "mocha": "^12.0.1",
    "mongodb-memory-server": "^11.2.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "unicorn-magic": "0.2.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
